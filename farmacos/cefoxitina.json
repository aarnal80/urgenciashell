{
 "drug_id": "cefoxitina",
 "presentacion": "CEFOXITINA LDP LABORATORIOS TORLAN 1 G POLVO PARA SOLUCION INYECTABLE Y PARA PERFUSION EFG",
 "nregistro": "84251",
