{
    "drug_id":  "etilefrina",
    "presentacion":  "EFORTIL 10 MG/ML SOLUCION INYECTABLE Y PARA PERFUSION",
    "nregistro":  "22007",
    "fuente":  "Ficha tÃ©cnica AEMPS/CIMA",
