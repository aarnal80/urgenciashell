e:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:134.4pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Trastornos de la piel y del tejido subcutáneo</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:197.05pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Erupción,  eritema, urticaria, prurito</span></p>\r\n        </td>\r\n\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:147.35pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Poco frecuente</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:197.05pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Dermatitis, hiperhidrosis, decoloración de la piel</span><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">2</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:147.35pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Rara</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-top-color:#000000; border-top-style:solid; border-top-width:1pt; vertical-align:top\"></td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:197.05pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Sudor frío</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:147.35pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Muy rara</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; vertical-align:top\"></td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:134.4pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Trastornos renales y urinarios</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:197.05pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Cromaturia</span><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">3</span></p>\r\n        </td>\r\n\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:147.35pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Rara</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:15.9pt\">\r\n        <td rowspan=\"3\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:134.4pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Trastornos generales y alteraciones en el lugar de administración</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:197.05pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Extravasación</span><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">4</span><span style=\"font-family:Times New Roman; font-size:11pt\">, malestar</span></p>\r\n        </td>\r\n\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:147.35pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Poco frecuente</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:15.85pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:197.05pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Dolor torácico, edema, astenia, sofocos, escalofríos</span></p>\r\n        </td>\r\n\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:147.35pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Rara</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr style=\"height:15.85pt\">\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:197.05pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Trombosis en el lugar de la inyección</span><span style=\"font-family:Times New Roman; font-size:7.33pt; vertical-align:super\">4</span><span style=\"font-family:Times New Roman; font-size:11pt\">, dolor</span></p>\r\n        </td>\r\n\r\n        <td colspan=\"2\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:147.35pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">No conocida</span></p>\r\n        </td>\r\n      </tr><!--[if !supportMisalignedColumns]><tr style=\"height:0pt\">\r\n                                        <td style=\"width:131pt; border:none\">\r\n                                        </td>\r\n                                        <td style=\"width:189.15pt; border:none\">\r\n                                        </td>\r\n                                        <td style=\"width:141.2pt; border:none\">\r\n                                        </td>\r\n                                        <td style=\"width:24.3pt; border:none\">\r\n                                        </td>\r\n                                </tr><![endif]-->\r\n    </table>\r\n\r\n    <p style=\"margin:0pt\"><em><span style=\"font-family:Times New Roman; font-size:6pt; vertical-align:super\">1</span></em> <em><span style=\"font-family:Times New Roman; font-size:9pt;\">Reacciones de hipersensibilidad, incluidos casos raros de shock anafiláctico/anafilactoide, que pueden tener un desenlace fatal</span></em></p>\r\n\r\n    <p style=\"margin:0pt\"><em><span style=\"font-family:Times New Roman; font-size:6pt; vertical-align:super\">2</span></em> <em><span style=\"font-family:Times New Roman; font-size:9pt;\">Puede aparecer una decoloración amarillenta de la piel después de la administración, pero generalmente desaparece dentro de las 6 a 12 horas.</span></em></p>\r\n\r\n    <p style=\"margin:0pt\"><em><span style=\"font-family:Times New Roman; font-size:6pt; vertical-align:super\">3</span></em> <em><span style=\"font-family:Times New Roman; font-size:9pt;\">La orina, que también puede presentar una coloración amarilla brillante, vuelve a su color normal después de 24 a 36 horas.</span></em></p>\r\n\r\n    <p style=\"margin:0pt\"><em><span style=\"font-family:Times New Roman; font-size:6pt; vertical-align:super\">4</span></em> <em><span style=\"font-family:Times New Roman; font-size:9pt;\">Extravasación de la solución que provoca un dolor intenso y puede ir seguida de necrosis tisular (ver Sección 4.4 Advertencias y precauciones especiales de empleo)</span></em></p>\r\n\r\n    <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n\r\n    <p style=\"margin:0pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Notificación de sospechas de reacciones adversas</span></u></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Es importante notificar sospechas de reacciones adversas al medicamento tras su autorización. Ello permite una supervisión continuada de la relación beneficio/riesgo del medicamento. Se invita a los profesionales sanitarios a notificar las sospechas de reacciones adversas a través del</span> <span style=\"font-family:Times New Roman; font-size:11pt\">Sistema Español de Farmacovigilancia de Medicamentos de Uso Humano</span><span style=\"font-family:Times New Roman; font-size:11pt\">:</span> <a href=\"http://www.notificaRAM.es\"><u><span style=\"font-family:Times New Roman; font-size:11pt; color:#0000ff\">www.notificaRAM.es</span></u></a><span style=\"font-family:Times New Roman; font-size:11pt\">.</span></p>\r\n  </div>",
   "vacia": false
  },
  {
   "id": "4.9",
   "titulo": "Sobredosis",
   "html": "<div>\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">No se esperan efectos tóxicos dado el mínimo riesgo de sobredosis con Fluoresceína Oculos.</span></p>\r\n  </div>",
   "vacia": false
  }
 ]
}