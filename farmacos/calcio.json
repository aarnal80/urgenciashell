r-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:99.2pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><span style=\"font-family:Times New Roman; font-size:11pt;\">Trastornos gastrointestinales</span></strong></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:49.65pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:49.8pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:77.75pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:77.95pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Estreñimiento, flatulencia, náuseas, dolor epigástrico y diarrea</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:56.7pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:48.15pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:99.2pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><strong><span style=\"font-family:Times New Roman; font-size:11pt;\">Trastornos de la piel y del tejido subcutáneo</span></strong></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:49.65pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:49.8pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:77.75pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:77.95pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:56.7pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Prurito, exantema y urticaria</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:48.15pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n        </td>\r\n      </tr>\r\n    </table>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Notificación de sospechas de reacciones adversas</span></u></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">Es importante notificar sospechas de reacciones adversas al medicamento tras su autorización. Ello permite una supervisión continuada de la relación beneficio/riesgo del medicamento. Se invita a los profesionales sanitarios a notificar las sospechas de reacciones adversas a través del Sistema Español de Farmacovigilancia de Medicamentos de Uso Humano: https://www.notificaram.es</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\"> </span></p>\r\n  </div>",
