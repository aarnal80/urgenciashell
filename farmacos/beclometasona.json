                      {
                          "id":  "4.3",
                          "titulo":  "Contraindicaciones",
                          "html":  "\u003cdiv\u003e\r\n    \u003cp style=\"margin:0pt; line-height:115%; font-size:11pt\"\u003e\u003cspan style=\"font-family:Times New Roman; font-size:11pt\"\u003eHipersensibilidad al principio activo o a alguno de los excipientes incluidos en la secci\u0026#243;n 6.1.\u003c/span\u003e\u003c/p\u003e\r\n  \u003c/div\u003e",
                          "vacia":  false
