top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:118.75pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">Epistaxis</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">Ardor nasal</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">irritaci&#243;n nasal</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">&#250;lceras nasales</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times; font-size:11pt\">&#xa0;</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:118.75pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">perforaci&#243;n del tabique</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">nasal</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times; font-size:11pt\">&#xa0;</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:118.75pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">Trastornos</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">gastrointestinales</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times; font-size:11pt\">&#xa0;</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:118.75pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times; font-size:11pt\">&#xa0;</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:118.75pt\">\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times; font-size:11pt\">Irritaci&#243;n de garganta</span><span style=\"font-family:Times; font-size:7.33pt; vertical-align:super\">*</span></p>\r\n        </td>\r\n\r\n        <td style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:118.75pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">alteraciones del olor y</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">del gusto</span></p>\r\n\r\n          <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times; font-size:11pt\">&#xa0;</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"4\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:475pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">*notificado en la poliposis nasal a dosis de dos veces al d&#237;a</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:9pt\">&#xa0;</span></p>\r\n        </td>\r\n      </tr>\r\n\r\n      <tr>\r\n        <td colspan=\"4\" style=\"border-bottom-color:#000000; border-bottom-style:solid; border-bottom-width:1pt; border-left-color:#000000; border-left-style:solid; border-left-width:1pt; border-right-color:#000000; border-right-style:solid; border-right-width:1pt; border-top-color:#000000; border-top-style:solid; border-top-width:1pt; padding-left:5.4pt; padding-right:5.4pt; vertical-align:top; width:475pt\">\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">&#8224;notificado como poco frecuente en la poliposis nasal a dosis de dos veces al d&#237;a</span></p>\r\n\r\n          <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:9pt\">&#xa0;</span></p>\r\n        </td>\r\n      </tr><!--[if !supportMisalignedColumns]><tr style=\"height:0pt\">\r\n                                        <td style=\"width:118.75pt; border:none\">\r\n                                        </td>\r\n                                        <td style=\"width:118.75pt; border:none\">\r\n                                        </td>\r\n                                        <td style=\"width:118.75pt; border:none\">\r\n                                        </td>\r\n                                        <td style=\"width:118.75pt; border:none\">\r\n                                        </td>\r\n                                </tr><![endif]-->\r\n    </table>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><em><span style=\"font-family:Times; font-size:11pt;\">&#xa0;</span></em></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><em><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Poblaci&#243;n pedi&#225;trica</span></u></em></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">En la poblaci&#243;n pedi&#225;trica, la incidencia de acontecimientos adversos registrados en los ensayos cl&#237;nicos, p.ej.: epistaxis (6%), cefalea (3%), irritaci&#243;n nasal (2%) y estornudos (2%), fue comparable a placebo.</span></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; text-align:justify\"><strong><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Notificaci&#243;n de sospechas de reacciones adversas</span></u></strong></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Es importante notificar las sospechas de reacciones adversas al medicamento tras su autorizaci&#243;n. Ello permite una supervisi&#243;n continuada de la relaci&#243;n beneficio/riesgo del medicamento. Se invita a los profesionales sanitarios a notificar las sospechas de reacciones adversas a trav&#233;s del Sistema Espa&#241;ol de Farmacovigilancia de Medicamentos de Uso Humano:</span> <a href=\"https://www.notificaram.es/\"><u><span style=\"font-family:Times New Roman; font-size:11pt; color:#0000ff\">https://www.notificaram.es</span></u></a><span style=\"font-family:Times New Roman; font-size:11pt\">.</span></p>\r\n  </div>",
   "vacia": false
  },
  {
   "id": "4.9",
   "titulo": "Sobredosis",
   "html": "<div>\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">S&#237;ntomas</span></u></p>\r\n\r\n    <p style=\"margin:0pt\"><span style=\"font-family:Times; font-size:11pt\">La inhalaci&#243;n o la administraci&#243;n oral de dosis excesivas de corticosteroides pueden derivar en la inhibici&#243;n de la funci&#243;n del eje HHS.</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><u><span style=\"font-family:Times New Roman; font-size:11pt;\">Tratamiento</span></u></p>\r\n\r\n    <p style=\"margin:0pt; line-height:115%; font-size:11pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">Debido a la biodisponibilidad sist&#233;mica insignificante (menos del 0,1</span><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span><span style=\"font-family:Times New Roman; font-size:11pt\">% utilizando un an&#225;lisis sensible con un l&#237;mite de cuantificaci&#243;n m&#237;nimo de 0,25</span><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span><span style=\"font-family:Times New Roman; font-size:11pt\">pg/ml) de la suspensi&#243;n para pulverizaci&#243;n nasal de mometasona furoato, resulta improbable que la sobredosis requiera otro tratamiento aparte de una observaci&#243;n seguida del comienzo de la administraci&#243;n de la dosis prescrita adecuada.</span></p>\r\n  </div>",
   "vacia": false
  }
 ]
}