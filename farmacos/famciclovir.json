   "id": "4.2",
   "titulo": "Posología y forma de administración",
   "html": "<div>\r\n    <p style=\"margin:0pt\"><span style=\"font-family:Times New Roman; font-size:11pt\">&#xa0;</span></p>\r\n  </div>",
   "vacia": true
